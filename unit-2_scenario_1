
    if n == 0:
        return 0

    if n == 1:
        return 1

   
    if n in memo:
        return memo[n]

  
    memo[n] = fibonacci(n - 1, memo) + fibonacci(n - 2, memo)

    return memo[n]


N = int(input("Enter the number of Fibonacci numbers: "))


memo = {}

sequence = []

for i in range(N):
    value = fibonacci(i, memo)
    sequence.append(value)



print("\nFibonacci Sequence:")
print(sequence)

