
def unique_paths(rows, columns):

  
    dp = [[0 for _ in range(columns)] for _ in range(rows)]

    
    for i in range(rows):
        dp[i][0] = 1

    
    for j in range(columns):
        dp[0][j] = 1

    
    for i in range(1, rows):
        for j in range(1, columns):

           
            dp[i][j] = dp[i - 1][j] + dp[i][j - 1]

    
    return dp[rows - 1][columns - 1], dp

print("========================================")
print("          UNIQUE PATHS PROBLEM")
print("       USING DYNAMIC PROGRAMMING")
print("========================================")


rows = int(input("Enter number of rows: "))
columns = int(input("Enter number of columns: "))


if rows <= 0 or columns <= 0:
    print("Rows and columns must be greater than 0.")

else:
    
    result, dp = unique_paths(rows, columns)

    
    print("\nDP Table:")

    for row in dp:
        print(row)

    
    print("\nTotal number of unique paths:", result)
